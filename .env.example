# Workless — Environment Configuration
# Copy this file to .env and adjust values

# --- App ---
APP_NAME=Workless
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=workless
DB_USERNAME=workless
DB_PASSWORD=workless_secret

# --- Redis (Queue + Cache) ---
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# --- Laravel Sanctum (API Auth) ---
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000
SESSION_DOMAIN=localhost

# --- Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=workless@localhost
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Laravel Reverb (WebSocket) ---
REVERB_APP_ID=workless
REVERB_APP_KEY=workless-key
REVERB_APP_SECRET=workless-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Logging ---
LOG_CHANNEL=stack
LOG_LEVEL=debug
